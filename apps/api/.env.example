# SARGuardian API — local/server configuration example.
# Replace placeholders in the hosting environment; never commit live values.

APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

# Firebase Admin server credentials. Keep the real file/JSON outside source control.
GOOGLE_APPLICATION_CREDENTIALS=path/to/server-side-firebase-admin-credentials.json
# FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-server-side-service-account-json

# NISAR catalogue discovery.
ASF_CATALOG_ENABLED=true
ASF_SEARCH_URL=https://api.daac.asf.alaska.edu/services/search/param
ASF_MAX_RESULTS=2000
ASF_TIMEOUT_SECONDS=20
PREFLIGHT_TTL_SECONDS=86400

# Server-only Supabase persistence.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-secret

# GitHub Actions dispatch — all workflow destinations stay in this repository.
# Keep processing disabled until repository variables, worker secrets, callback
# secrets, and the API callback URL have been verified for this repository.
GITHUB_ACTIONS_TOKEN=replace-with-repository-scoped-actions-token
GITHUB_ACTIONS_REPOSITORY=shourov-04/SARGuardian
GITHUB_ACTIONS_WORKFLOW=sarguardian-aoi-wkt-dashboard.yml
GITHUB_ACTIONS_REF=main
DISPLACEMENT_ACTIONS_ENABLED=false
DISPLACEMENT_CALLBACK_SECRET=replace-with-long-random-hmac-secret
PUBLIC_API_URL=https://api.example.org

KNOWN_PLACE_GITHUB_ACTIONS_REPOSITORY=shourov-04/SARGuardian
KNOWN_PLACE_GITHUB_ACTIONS_WORKFLOW=know-place-aoi-dispatcher.yml
KNOWN_PLACE_GITHUB_ACTIONS_REF=main
KNOWN_PLACE_PAPER_GITHUB_ACTIONS_REPOSITORY=shourov-04/SARGuardian
KNOWN_PLACE_PAPER_GITHUB_ACTIONS_WORKFLOW=know-place-paper-reproduction-dispatcher.yml
KNOWN_PLACE_PAPER_GITHUB_ACTIONS_REF=main

RIVERSHIFT_ACTIONS_ENABLED=false
RIVERSHIFT_GITHUB_ACTIONS_TOKEN=replace-with-repository-scoped-actions-token
RIVERSHIFT_GITHUB_ACTIONS_REPOSITORY=shourov-04/SARGuardian
RIVERSHIFT_GITHUB_ACTIONS_WORKFLOW=river-shift-gcov-process.yml
RIVERSHIFT_GITHUB_ACTIONS_REF=main
RIVERSHIFT_CALLBACK_SECRET=replace-with-long-random-hmac-secret
RIVERSHIFT_PUBLIC_API_URL=https://api.example.org

# Repository-level Actions variables (set in shourov-04/SARGuardian only):
# MONOREPO_DISPLACEMENT_ACTIONS_ENABLED=true
# MONOREPO_KNOWN_PLACE_ACTIONS_ENABLED=true
# MONOREPO_KNOWN_PLACE_PAPER_REPRODUCTION_ENABLED=true
# MONOREPO_RIVERSHIFT_PROCESSING_ENABLED=true
#
# Enable each workflow only after its required Earthdata, Drive, callback,
# Supabase/Firebase and API settings have been checked. The API feature flags
# above remain false by default; these comments do not enable any processing.
